          "refId": "A"
        },
        {
          "expr": "queue_dlq_depth",
          "legendFormat": "DLQ - {{queue}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineInterpolation": "stepAfter" },
          "unit": "short"
        }
      }
    },
    {
