# ==============================================================================
# Zipli Pro Quick-Commerce Environment Configuration Template
# ==============================================================================

# Server Network Configuration (Port 5001 avoids macOS AirPlay collision on 5000)
PORT=5001
NODE_ENV=development

# Database Configuration (PostgreSQL 16 + pgvector)
DATABASE_URL=postgresql://zipli_user:zipli_pass@localhost:5432/zipli
PGHOST=localhost
PGPORT=5432
PGDATABASE=zipli
PGUSER=zipli_user
PGPASSWORD=zipli_pass
PGPOOL_MAX=20
PG_IDLE_TIMEOUT_MS=30000

# Redis Cache & Message Broker (Optional in dev, falls back to in-memory queues)
REDIS_URL=redis://localhost:6379

# Authentication & Cryptographic Security
# NOTE: In production (NODE_ENV=production), JWT_SECRET must be at least 32 characters
# and cannot contain insecure placeholder strings ('change', 'secret', or 'example').
JWT_SECRET=zipli_dev_jwt_secret_must_be_long_and_secure_min32chars
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_EXPIRES_IN=30d
BCRYPT_ROUNDS=10

# Cross-Origin Resource Sharing (Comma-separated list of origins)
CORS_ORIGIN=http://localhost:3000,http://localhost:80,http://127.0.0.1:5500,http://127.0.0.1:80

# Quick-Commerce Logistics & Business Rules
DELIVERY_FEE=2
FREE_DELIVERY_THRESHOLD=199
STOCK_RESERVATION_TTL_MINUTES=10

# Rate Limiting & GCRA Throttling
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Observability & Metrics
METRICS_PORT=9090
LOG_LEVEL=info
