# ==============================================================================
# ZIPLI PRO — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env before starting the production deployment.
# IMPORTANT: The production boot guard (backend/src/config/env.js) will FAIL
# intentionally until you replace the placeholder values below with real, high-entropy secrets.

NODE_ENV=production
PORT=5001

# DATABASE CONFIGURATION
# Production database credentials (must not use default 'zipli_pass' or 'postgres')
POSTGRES_DB=zipli
POSTGRES_USER=zipli_app_user
POSTGRES_PASSWORD=REPLACE_WITH_SECURE_DATABASE_PASSWORD_FROM_SECRETS_MANAGER
DATABASE_URL=postgresql://zipli_app_user:REPLACE_WITH_SECURE_DATABASE_PASSWORD_FROM_SECRETS_MANAGER@postgres:5432/zipli

# REDIS DISTRIBUTED CACHE & QUEUE
REDIS_PASSWORD=REPLACE_WITH_SECURE_REDIS_PASSWORD
REDIS_URL=redis://:REPLACE_WITH_SECURE_REDIS_PASSWORD@redis:6379

# AUTHENTICATION & SECURITY
# Minimum 32 characters, no placeholder words ("change", "secret", "example", "zip")
JWT_SECRET=REPLACE_WITH_A_REAL_SECURE_RANDOM_SECRET_NOT_CONTAINING_PLACEHOLDER_WORDS
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# CORS & NETWORK (Comma-separated allowed origins)
CORS_ORIGIN=https://zipli.example.com,https://admin.zipli.example.com

# LOGISTICS & COMMERCE
DELIVERY_FEE=25
MAX_DELIVERY_RADIUS_KM=10.0

# RAZORPAY / PAYMENT GATEWAY (Optional until pilot launch)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# AI GATEWAY & ASSISTIVE SERVICES (P0 / P1)
AI_ENABLED=true
AI_MODEL=claude-3-5-sonnet-latest
AI_MAX_TOKENS=1024
AI_DAILY_TOKEN_BUDGET=50000
ANTHROPIC_API_KEY=
EMBEDDING_PROVIDER=local
EMBEDDING_API_KEY=
